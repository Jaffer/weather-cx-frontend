# ==============================================================================
# Google Cloud Service Account Credentials
# ==============================================================================
# Obtain these from a Google Cloud Service Account with the 
# "Dialogflow Client" or "Dialogflow API Reader/Admin" role.
GOOGLE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com

# The private key from your service account JSON key file.
# Keep the quotes if the key contains line breaks or \n escape sequences.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# Dialogflow CX Agent Details
# ==============================================================================
# Your GCP Project ID (e.g., "my-weather-app-123456")
DIALOGFLOW_PROJECT_ID=your-project-id

# Region where your Dialogflow CX agent is located
# Common options: global, us-central1, europe-west1, asia-northeast1, etc.
# Note: Non-global locations automatically configure <location>-dialogflow.googleapis.com
DIALOGFLOW_LOCATION=us-central1

# Dialogflow CX Agent UUID from the CX console URL
# e.g., in https://dialogflow.cloud.google.com/cx/projects/proj/locations/us-central1/agents/<agent-id>
DIALOGFLOW_AGENT_ID=00000000-0000-0000-0000-000000000000

